---
/**
 * TrustMetrics — key social proof numbers displayed in a compact grid.
 *
 * CountUp is a Preact component that animates a number from `initial` to
 * `final` over `duration` ms using the useProgressiveNumber hook.
 * `client:visible` defers hydration until the section scrolls into view,
 * so the animation plays at the right moment without blocking the initial load.
 */
import { CountUp } from "@components/ui/CountUp.tsx";
---

<section
  aria-label="Métricas de confianza"
  class="bg-[#F0FBFC] dark:bg-[#060B0D]"
>
  <!-- Separador superior — gradiente verde, mismo que terminaba el Hero -->
  <div class="mx-auto max-w-3xl px-4">
    <div
      aria-hidden="true"
      class="h-px w-full bg-linear-to-r from-transparent via-cyan-500 to-transparent dark:via-cyan-400"
    >
    </div>
  </div>

  <!-- Grid de métricas -->
  <div
    class="mx-auto grid w-full max-w-3xl grid-cols-2 gap-x-4 gap-y-8 px-4 py-12 md:grid-cols-4"
    role="list"
  >
    <!-- +5 años -->
    <div class="flex flex-col items-center gap-1.5 text-center" role="listitem">
      <p
        class="font-display text-3xl font-bold text-zinc-800 tabular-nums md:text-4xl dark:text-zinc-50"
      >
        +<CountUp client:visible initial={0} final={5} duration={1200} />
      </p>
      <p
        class="text-xs font-semibold tracking-[0.2em] text-cyan-700 uppercase dark:text-cyan-400"
      >
        Años desarrollando
      </p>
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500">webs profesionales</p>
    </div>

    <!-- 100 Lighthouse -->
    <div class="flex flex-col items-center gap-1.5 text-center" role="listitem">
      <p
        class="font-display text-3xl font-bold text-zinc-800 tabular-nums md:text-4xl dark:text-zinc-50"
      >
        <CountUp client:visible initial={0} final={100} duration={1400} />
      </p>
      <p
        class="text-xs font-semibold tracking-[0.2em] text-cyan-700 uppercase dark:text-cyan-400"
      >
        Lighthouse score
      </p>
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500">velocidad y SEO perfectos</p>
    </div>

    <!-- Clientes atendidos -->
    <div class="flex flex-col items-center gap-1.5 text-center" role="listitem">
      <p
        class="font-display text-3xl font-bold text-zinc-800 tabular-nums md:text-4xl dark:text-zinc-50"
      >
        <CountUp client:visible initial={0} final={10} duration={1200} />+
      </p>
      <p
        class="text-xs font-semibold tracking-[0.2em] text-cyan-700 uppercase dark:text-cyan-400"
      >
        Clientes atendidos
      </p>
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500">México y Estados Unidos</p>
    </div>

    <!-- Entrega puntual -->
    <div class="flex flex-col items-center gap-1.5 text-center" role="listitem">
      <p
        class="font-display text-3xl font-bold text-zinc-800 tabular-nums md:text-4xl dark:text-zinc-50"
      >
        <CountUp client:visible initial={0} final={100} duration={1400} />%
      </p>
      <p
        class="text-xs font-semibold tracking-[0.2em] text-cyan-700 uppercase dark:text-cyan-400"
      >
        Entrega a tiempo
      </p>
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500">sin sorpresas ni retrasos</p>
    </div>
  </div>
</section>
