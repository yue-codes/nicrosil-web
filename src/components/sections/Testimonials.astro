---
/**
 * Testimonials — Citas reales de clientes.
 *
 * ⚠️  REEMPLAZA el contenido de cada testimonio con las citas reales
 *     que te proporcionen tus clientes antes de publicar.
 *
 * Campos:
 *   quote    — texto de la cita (puede incluir <strong> para énfasis)
 *   name     — nombre del cliente o representante
 *   role     — puesto o descripción ("Dueño, Trasciende Gym")
 *   initials — 1-2 letras para el avatar cuando no hay foto
 *   avatarColor — color de fondo del avatar (tailwind arbitrary o hex)
 */

const testimonials = [
  {
    quote:
      "¡Súper recomendado!, buscaba a alguien que entendiera mi visión y él lo logró desde el día uno. Me explicó de forma súper clara los beneficios de la web y diseñó una página increíble para el gym. Es un profesional que sabe escuchar y cumple con lo que promete. ¡Muchas gracias por el gran trabajo!",
    name: "Ely Oriz",
    role: "Trasciende Gym",
    initials: "TG",
    avatarColor: "#0D3828",
    // ↑ REEMPLAZA esta cita con la frase real del cliente
  },
  {
    quote:
      "¡Excelente servicio! Inicialmente, teníamos una web hecha por otros que se había quedado completamente atrás y desactualizada, pero él llegó, entendió lo que necesitábamos y la rediseñó por completo. Ahora, acaba de realizar una nueva actualización que nos ha encantado. Sabe escuchar la evolución de nuestro negocio y plasmarla en la página con total fluidez. Un profesional de confianza con el que da gusto seguir trabajando a largo plazo.",
    name: "Andrea G.",
    role: "Magical Cleaning",
    initials: "MC",
    avatarColor: "#072234",
    // ↑ REEMPLAZA esta cita con la frase real del cliente
  },
];
---

<section
  class="bg-[#E5F7FA] py-24 dark:bg-[#0B1519]"
  aria-labelledby="testimonios-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <!-- Encabezado -->
    <div class="mb-14 text-center">
      <p
        class="mb-3 text-xs font-semibold tracking-[0.2em] uppercase text-cyan-700 dark:text-cyan-400"
      >
        Lo que dicen los clientes
      </p>
      <h2
        id="testimonios-heading"
        class="font-display text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50"
      >
        Resultados que hablan
      </h2>
    </div>

    <!-- Grid de citas -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        testimonials.map(({ quote, name, role, initials, avatarColor }) => (
          <figure class="flex flex-col gap-6 rounded-3xl border border-cyan-200/60 bg-white p-8 shadow-sm dark:border-cyan-900/30 dark:bg-white/4">
            <!-- Comilla decorativa -->
            <span
              aria-hidden="true"
              class="font-display text-5xl leading-none font-black text-cyan-500/20 select-none dark:text-cyan-400/20"
            >
              "
            </span>

            <blockquote class="-mt-4 flex-1">
              <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
                {quote}
              </p>
            </blockquote>

            <!-- Autor -->
            <figcaption class="flex items-center gap-3 border-t border-zinc-100 pt-5 dark:border-white/8">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
                style={`background-color: ${avatarColor};`}
                aria-hidden="true"
              >
                {initials}
              </div>
              <div>
                <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">
                  {name}
                </p>
                <p class="text-xs text-zinc-400 dark:text-zinc-500">{role}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
