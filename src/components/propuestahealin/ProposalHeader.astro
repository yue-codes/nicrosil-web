---
/**
 * ProposalHeader — barra superior mínima para la propuesta de Heal in.
 * Sin navegación al sitio principal: la atención debe quedarse en esta página.
 */
import ThemeToggle from "@components/interactive/ThemeToggle.tsx";
---

<header
  class="pointer-events-none fixed top-0 z-50 flex w-full justify-center px-4 py-4"
>
  <div
    class="pointer-events-auto flex w-full max-w-3xl items-center justify-between gap-4 rounded-full border border-white/50 bg-white/50 px-4 py-2 shadow-sm backdrop-blur-md dark:border-white/10 dark:bg-zinc-900/50"
  >
    <div class="flex items-center gap-2">
      <img
        src="/favicon.svg"
        alt=""
        width="22"
        height="22"
        loading="eager"
        decoding="async"
        class="dark:invert"
        aria-hidden="true"
      />
      <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">
        Nicrosil
      </span>
    </div>

    <span
      class="hidden rounded-full bg-[#5B6B4F]/10 px-3 py-1 text-xs font-semibold text-[#4B5A3F] sm:inline-block dark:bg-[#9CAE87]/15 dark:text-[#B7C7A3]"
    >
      Propuesta para Heal in
    </span>

    <div class="flex items-center gap-2">
      <ThemeToggle
        client:only="preact"
        storageKey="healin-theme"
        followSystemTheme={false}
      />

      <a
        href="#contacto"
        class="rounded-full bg-[#5B6B4F] px-4 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:brightness-110"
      >
        Hablemos
      </a>
    </div>
  </div>
</header>
