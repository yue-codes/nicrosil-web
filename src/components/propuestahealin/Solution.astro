---
import SectionHeader from "@components/ui/SectionHeader.astro";

const services = [
  {
    title: "Nutrición funcional",
    description:
      "Pérdida de peso, salud digestiva, salud metabólica y hormonal, y nutrición estética anti-envejecimiento — cada una con su propio espacio, explicada como tú la explicas.",
    color: "#5B6B4F",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  },
  {
    title: "Tus servicios especializados",
    description:
      "Cualquier evaluación o programa particular que ofrezcas merece su propia página: qué es, para quién es y cómo agendarlo, sin depender de un mensaje directo.",
    color: "#4A7B8C",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/></svg>`,
  },
  {
    title: "Tu tienda",
    description:
      "Catálogo con tus productos, precios claros y pedidos directos a tu WhatsApp — sin fricción entre que alguien te ve y te compra.",
    color: "#B08968",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    title: "Agenda presencial y en línea",
    description:
      "Un solo botón para que elijan consultorio en Oaxaca o consulta virtual, sin ida y vuelta de mensajes para cuadrar horario.",
    color: "#7C8F63",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="m9 16 2 2 4-4"/></svg>`,
  },
];

const extras = [
  {
    title: "Que te encuentren en Google",
    description:
      '"Nutrióloga en Oaxaca" debería llevar directo a ti. Trabajo el SEO desde la base, no como un extra de última hora.',
    color: "#4A7B8C",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  },
  {
    title: "Un blog que sí suma",
    description:
      "Tus tips dejan de perderse en el scroll. Cada artículo también te va posicionando en Google, mes tras mes.",
    color: "#5B6B4F",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>`,
  },
  {
    title: "Cambios sin límite",
    description:
      "Tu negocio va a evolucionar y tu sitio también. Cualquier ajuste que necesites, lo hacemos — no es un producto congelado.",
    color: "#B08968",
    iconHtml: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3.5-7.1"/><path d="M21 3v6h-6"/></svg>`,
  },
];
---

<section
  id="propuesta"
  class="bg-white py-24 dark:bg-[#050705]"
  aria-labelledby="solucion-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader
      eyebrow="La propuesta"
      id="solucion-heading"
      description="Un sitio construido alrededor de lo que ya ofreces, no una plantilla genérica de nutrióloga."
      eyebrowStyle="color: #5B6B4F"
    >
      Todo lo que Heal in<br class="hidden sm:block" />
      <span class="text-[#5B6B4F] dark:text-[#9CAE87]">necesita para brillar</span>
    </SectionHeader>

    <!-- Servicios -->
    <div class="mb-16 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        services.map(({ title, description, color, iconHtml }) => (
          <div class="group relative overflow-hidden rounded-2xl border border-[#5B6B4F]/15 bg-[#FAFAF7] p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-[#9CAE87]/15 dark:bg-white/4">
            <div
              aria-hidden="true"
              class="absolute top-0 left-0 h-1 w-full"
              style={`background-color: ${color};`}
            />
            <div
              class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-300 group-hover:scale-110"
              style={`background-color: ${color}1A; color: ${color};`}
            >
              <Fragment set:html={iconHtml} />
            </div>
            <p class="mb-2 text-base font-semibold text-zinc-900 dark:text-zinc-50">
              {title}
            </p>
            <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
              {description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Extras que marcan la diferencia -->
    <div class="rounded-3xl bg-[#5B6B4F]/5 p-8 dark:bg-[#9CAE87]/5 md:p-10">
      <p class="mb-8 text-center text-sm font-semibold text-[#4B5A3F] dark:text-[#B7C7A3]">
        Y lo que casi nadie ofrece de fondo
      </p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          extras.map(({ title, description, color, iconHtml }) => (
            <div class="text-center">
              <div
                class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full"
                style={`background-color: ${color}1A; color: ${color};`}
              >
                <Fragment set:html={iconHtml} />
              </div>
              <p class="mb-2 text-base font-semibold text-zinc-900 dark:text-zinc-50">
                {title}
              </p>
              <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
                {description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
