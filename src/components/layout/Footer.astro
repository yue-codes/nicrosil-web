---
import { navLinks } from "../../data/navigation.ts";
import PulseDot from "@components/ui/PulseDot.astro";
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 bg-[#F0FBFC] py-10 dark:border-[#152119] dark:bg-[#040807]">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Fila principal -->
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row sm:items-start">

      <!-- Logo + ubicación -->
      <div>
        <a href="/" aria-label="Nicrosil — Inicio" class="flex items-center gap-2">
          <img
            src="/favicon.svg"
            alt=""
            width="27"
            height="27"
            class="dark:invert"
            aria-hidden="true"
          />
          <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">Nicrosil.Dev</span>
        </a>
        <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">México &mdash; Alcance Global</p>
      </div>

      <!-- Nav -->
      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap justify-center gap-6" role="list">
          {
            navLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-zinc-500 transition-colors hover:text-cyan-600 dark:text-zinc-400 dark:hover:text-zinc-50"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

    </div>

    <!-- Separador -->
    <div class="my-6 h-px w-full bg-zinc-200 dark:bg-white/8"></div>

    <!-- Fila inferior: disponibilidad + email + WhatsApp + copyright -->
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">

      <!-- Izquierda: badge disponible + email -->
      <div class="flex flex-wrap items-center gap-4">

        <!-- Badge disponible -->
        <div class="inline-flex items-center gap-1.5 rounded-full border border-green-600/25 bg-green-500/10 px-3 py-1.5">
          <span class="relative flex h-2.5 w-2.5 items-center justify-center">
            <PulseDot color="green" />
          </span>
          <span class="text-xs font-semibold text-green-600 dark:text-green-400">
            Disponible para proyectos
          </span>
        </div>

        <!-- Email -->
        <a
          href="mailto:contacto@nicrosil.dev"
          class="flex items-center gap-1.5 text-xs text-zinc-400 transition-colors hover:text-cyan-600 dark:text-zinc-500 dark:hover:text-cyan-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          contacto@nicrosil.dev
        </a>

        <!-- WhatsApp — link inyectado por JS para no indexar el número -->
        <a
          id="footer-wa"
          href="#"
          aria-label="Contactar por WhatsApp"
          class="flex items-center gap-1.5 text-xs text-zinc-400 transition-colors hover:text-green-600 dark:text-zinc-500 dark:hover:text-green-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Derecha: copyright -->
      <p class="text-xs text-zinc-400 dark:text-zinc-600">
        &copy; {year} Nicrosil
      </p>

    </div>
  </div>
</footer>

<script>
  // El número se ensambla en el cliente para evitar indexación por crawlers
  const parts = ["https://wa.me/", "5222", "01298518"];
  const el = document.getElementById("footer-wa") as HTMLAnchorElement | null;
  if (el) el.href = parts.join("");
</script>
